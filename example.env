# God Mode OTP Capture Bot sample environment variables
# Copy this file to .env and fill in the values.

TELEGRAM_TOKEN=
SUPERADMINS=123456789,987654321
EDITORS=123456789
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_VIRTUAL_NUMBER=
BASE_URL=https://your-public-domain.example
SMS_FROM=VonageBot

# Optional infrastructure settings
# Leave DATABASE_URL blank to use local SQLite by default.
DATABASE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=False
TOR_PROXY=
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=

# Optional secrets
ENCRYPTION_KEY=
ENCRYPTION_KEY_FILE=./encryption_key
